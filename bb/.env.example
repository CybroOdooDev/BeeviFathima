# --- app ---------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000

# --- stores ------------------------------------------------------------------
# SQLite needs nothing installed. Use Postgres in production:
#   postgresql+psycopg://user:pass@host:5432/biobridge
DATABASE_URL=sqlite:///./biobridge.db
# Empty means no broker: the API runs syncs inline instead of queuing them.
REDIS_URL=

# --- secrets -----------------------------------------------------------------
# Generate both with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to boot in production while these are the dev defaults.
#
# BACK UP MASTER_ENCRYPTION_KEY. Every tenant credential is encrypted with a key
# derived from it; losing it means losing every stored connection.
JWT_SECRET=dev-only-change-me-at-least-32-characters
MASTER_ENCRYPTION_KEY=dev-only-master-key-not-for-production

# --- sync engine -------------------------------------------------------------
DEFAULT_SYNC_INTERVAL_MINUTES=15
FETCH_OVERLAP_MINUTES=15
BACKFILL_LIMIT_DAYS=30
MAX_CONSECUTIVE_FAILURES=5
HTTP_TIMEOUT_SECONDS=30

# --- security ----------------------------------------------------------------
# false in a public deployment: customer BioTime servers must then be reachable
# via a public hostname or a tunnel rather than a private address.
ALLOW_PRIVATE_NETWORK_TARGETS=true
# Empty = same-origin only. Never "*" in production.
CORS_ORIGINS=
