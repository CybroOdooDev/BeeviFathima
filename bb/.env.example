# --- app ---------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000
# The marketing website (registration, confirmation pages). Emails and Stripe
# send visitors back here. Also add it to CORS_ORIGINS below.
SITE_URL=http://127.0.0.1:8080
# ZKTeco "Cloud push" terminals: the address customers type into the device's
# Cloud Server Setting. Empty host / 0 port = taken from PUBLIC_BASE_URL.
# Terminals speak plain HTTP to /iclock/ — keep that path reachable over HTTP
# (no forced redirect to HTTPS) on this host and port.
ADMS_SERVER_HOST=
ADMS_SERVER_PORT=0
# Website registrations / resend requests allowed per IP per hour.
REGISTRATION_RATE_PER_HOUR=10

# --- stores ------------------------------------------------------------------
# SQLite needs nothing installed. Use Postgres in production:
#   postgresql+psycopg://user:pass@host:5432/biobridge
DATABASE_URL=sqlite:///./biobridge.db
# Empty means no broker: the API runs syncs inline instead of queuing them, and
# the scheduler below runs in the API process. Setting this hands the schedule
# to Celery beat instead — see SCHEDULER_MODE.
REDIS_URL=

# --- scheduling --------------------------------------------------------------
# Who runs the clock:
#   auto      the API schedules unless REDIS_URL is set, then Celery beat does
#   inprocess the API always schedules. One service, no broker, no worker
#   celery    beat only. The API never dispatches on a timer
#   off       nothing is scheduled; syncs only happen when triggered
# Safe to leave at auto. Running several API replicas is also safe: a database
# lease picks one dispatcher, so scaling out does not multiply the syncs.
SCHEDULER_MODE=auto
# How often the loop wakes. Not the sync frequency — each account sets its own
# interval in Settings — only how late a due account can be.
SCHEDULER_TICK_SECONDS=60
# Accounts synced at once. A cycle is I/O-bound on two remote systems.
SCHEDULER_CONCURRENCY=4
# Lease lifetime: longer than a tick, short enough that a killed process is
# replaced within a minute or two.
SCHEDULER_LEASE_TTL_SECONDS=180

# --- secrets -----------------------------------------------------------------
# Generate both with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to boot in production while these are the dev defaults.
#
# BACK UP MASTER_ENCRYPTION_KEY. Every tenant credential is encrypted with a key
# derived from it; losing it means losing every stored connection.
JWT_SECRET=dev-only-change-me-at-least-32-characters
MASTER_ENCRYPTION_KEY=dev-only-master-key-not-for-production

# --- sync engine -------------------------------------------------------------
DEFAULT_SYNC_INTERVAL_MINUTES=15
FETCH_OVERLAP_MINUTES=15
BACKFILL_LIMIT_DAYS=30
MAX_CONSECUTIVE_FAILURES=5
HTTP_TIMEOUT_SECONDS=30

# --- subscriptions -------------------------------------------------------------
# Applied once, at signup or staff onboarding — see README.md#subscription-plans.
TRIAL_DAYS=10
# Same, for a signup that skips the trial and starts on a chosen plan right
# away (SignupRequest.skip_trial) — there is still no real billing behind it.
BILLING_PERIOD_DAYS=30
# How close to the renewal date before the warning banner/tag appears.
SUBSCRIPTION_WARNING_DAYS=7
# Inside this many days, the same warning switches to its urgent styling.
SUBSCRIPTION_URGENT_DAYS=3

# --- security ----------------------------------------------------------------
# false in a public deployment: customer BioTime servers must then be reachable
# via a public hostname or a tunnel rather than a private address.
ALLOW_PRIVATE_NETWORK_TARGETS=true
# Empty = same-origin only. Never "*" in production. The marketing site's
# origin goes here, e.g. CORS_ORIGINS=https://biobridge.io
CORS_ORIGINS=http://127.0.0.1:8080

# --- email genuineness ---------------------------------------------------------
# A real MX/A lookup on signup and staff-onboarded accounts, not just syntax
# checking. Needs outbound DNS — turn off only if this deployment has none.
VERIFY_EMAIL_DELIVERABILITY=true
# Hours a confirmation link stays valid before POST /auth/resend-verification
# is needed.
EMAIL_VERIFICATION_TTL_HOURS=48

# --- outbound mail -------------------------------------------------------------
# Empty SMTP_HOST means mail is logged instead of sent — fine for development,
# not for production, where a customer needs to actually receive the link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@biobridge.app

# --- online billing (Stripe) -----------------------------------------------------
# Empty STRIPE_SECRET_KEY means no online billing: staff assign plans and
# renewal dates by hand, as before. Use test-mode keys (sk_test_…) first.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointed at
#   <PUBLIC_BASE_URL>/api/v1/billing/webhook
# (Stripe dashboard → Developers → Webhooks, or `stripe listen --forward-to …`).
STRIPE_WEBHOOK_SECRET=
# One monthly Price per plan, read by tools/seed_plans.py:
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
