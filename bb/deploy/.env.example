# deploy/.env — values docker compose itself needs (not the app's settings,
# which live in the app env file). Copy to deploy/.env.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Local: the port the dashboard is published on.
API_PORT=8000

# Production override only (docker-compose.prod.yml):
APP_DOMAIN=app.biobridge.example
ACME_EMAIL=ops@biobridge.example
ADMS_PORT=8081

# Optional: a different app env file than the project's .env
# BIOBRIDGE_ENV_FILE=../.env.production

# Importing an old SQLite database (profile "import"):
# SQLITE_FILE=../biobridge.db
# OLD_MASTER_ENCRYPTION_KEY=   # only when the new stack uses a different key

# Mock BioTime in the stack (profile "mock"), development only:
# MOCK_TENANT=cybrotech
# MOCK_PORT=8100
# MOCK_TZ=Asia/Kolkata
# HOST_UID=1000   # `id -u`, owner of mock_data/
# HOST_GID=1000
