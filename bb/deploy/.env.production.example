# Copy to /opt/biobridge/.env on the server (the app env file) and fill in.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=production
DEBUG=false
PUBLIC_BASE_URL=https://app.biobridge.example
SITE_URL=https://biobridge.example
CORS_ORIGINS=https://biobridge.example,https://app.biobridge.example

JWT_SECRET=
MASTER_ENCRYPTION_KEY=

# Staff console login (/#/staff/login) when you cannot run tools/grant_admin.py on
# the host. Both or neither; at least 12 characters. Created at start-up with no
# workspace; change the password here and restart to rotate it.
STAFF_EMAIL=
STAFF_PASSWORD=

# ZKTeco push terminals: Menu → Comm. → Cloud Server → this host and port.
ADMS_SERVER_HOST=app.biobridge.example
ADMS_SERVER_PORT=8081

SCHEDULER_MODE=auto
ALLOW_PRIVATE_NETWORK_TARGETS=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@biobridge.example

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
